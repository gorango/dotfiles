{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "tokyonight"
    },
    "diffs": {
        "wrap": "word",
        "view": "auto"
    },
    "session": {
        "sidebar": "hide",
        "scrollbar": true,
        "thinking": "hide",
        "markdown": "source",
        "tps": true,
        "image_preview": true,
        "verbosity": "low",
        "grouping": "auto",
        "permissions": "autoaccept"
    },
    "animations": true,
    "tabs": {
        "layout": "vertical",
        "enabled": true,
        "indicators": "status",
        "scope": "cwd"
    },
    "attention": {
        "volume": 0.8,
        "sound": true,
        "notifications": true
    },
    "keybinds": {
        "session.tab.next": "ctrl+pagedown",
        "session.tab.previous": "ctrl+pageup"
    },
    "terminal": {
        "copy": "select"
    }
}

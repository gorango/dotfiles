{
    "$schema": "https://opencode.ai/v2/config.json",
    "share": "manual",
    "autoupdate": true,
    "lsp": {},
    "mcp": {
        "servers": {
            "exa": {
                "type": "remote",
                "url": "https://mcp.exa.ai/mcp",
                "disabled": true,
                "headers": {
                    "authorization": "Bearer ${EXA_API_KEY}"
                }
            },
            "deepwiki": {
                "type": "remote",
                "url": "https://mcp.deepwiki.com/mcp",
                "disabled": false
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "chrome-devtools-mcp@latest",
                    "--no-usage-statistics"
                ],
                "disabled": true
            },
            "brave-devtools": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "brave-devtools-mcp@latest"
                ],
                "disabled": true
            },
            "trigger": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "trigger.dev@latest",
                    "mcp"
                ],
                "disabled": true
            },
            "codegraph": {
                "type": "local",
                "command": [
                    "codegraph",
                    "serve",
                    "--mcp"
                ],
                "disabled": false
            }
        }
    }
}

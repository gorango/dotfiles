{
    "$schema": "https://opencode.ai/config.json",
    "share": "manual",
    "update": "auto",
    "lsp": {},
    "permissions": [
        {
            "action": "giga.orch",
            "resource": "*",
            "effect": "ask"
        }
    ],
    "experimental": {
        "todo": true
    },
    "plugins": [
        "{env:HOME}/.config/opencode/plugins/giga",
        "{env:HOME}/.config/opencode/plugins/oracle"
    ],
    "mcp": {
        "servers": {
            "exa": {
                "type": "remote",
                "url": "https://mcp.exa.ai/mcp",
                "disabled": true,
                "headers": {
                    "authorization": "Bearer ${EXA_API_KEY}"
                }
            },
            "deepwiki": {
                "type": "remote",
                "url": "https://mcp.deepwiki.com/mcp",
                "disabled": false
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "chrome-devtools-mcp@latest",
                    "--no-usage-statistics"
                ],
                "disabled": true
            },
            "brave-devtools": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "brave-devtools-mcp@latest"
                ],
                "disabled": true
            },
            "trigger": {
                "type": "local",
                "command": [
                    "pnpm",
                    "dlx",
                    "trigger.dev@latest",
                    "mcp"
                ],
                "disabled": true
            }
        }
    }
}

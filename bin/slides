#!/bin/bash
dir=""
extra_flags=()
save_enabled=false

for arg in "$@"; do
  if [[ "$arg" == "--save" ]]; then
    save_enabled=true
  elif [[ -z "$dir" && -d "$arg" ]]; then
    dir="$arg"
  else
    extra_flags+=("$arg")
  fi
done

if [[ -z "$dir" ]]; then
  dir="$(pwd)"
fi

if $save_enabled; then
  save_dir="$dir/fave"
  mkdir -p "$save_dir"
  extra_flags+=(-j "$save_dir")
fi

nohup feh -Y -q -B black -Z -. -r \
  --action 'shotwell %F' \
  --action1 'videos %F' \
  --action2 'cd "$(dirname %F)" && setsid mpv --loop-playlist *.3g2 *.3gp *.asf *.avi *.divx *.f4v *.flv *.gif *.m2ts *.m2v *.m4a *.m4v *.mkv *.mov *.mp4 *.mpe *.mpeg *.mpg *.mts *.mxf *.ogm *.ogv *.rm *.rmvb *.ts *.vob *.webm *.wmv &' \
  --action9 'cd "$(dirname %F)" && slides -D 5 . &' \
  "${extra_flags[@]}" \
  "$dir" >/dev/null 2>&1 &
